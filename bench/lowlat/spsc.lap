// SPSC ring. One producer thread, the main thread consumes.
// Capacity 1024. Indices sit on distinct cache lines. 1000000 messages.
// Sum of 1..1000000 is 500000500000.
align(64) let volatile write_idx: u64 = 0;
align(64) let volatile read_idx: u64 = 0;
let buf: [u64; 1024];
let volatile tid: u32 = 0;
let stack: [u8; 65536];

fn producer() -> i64 {
    let w = 0;
    let i = 1;
    while (i <= 1000000) {
        while ((w - atomic_load_acquire(&read_idx)) == 1024) {
            cpu_pause();
        }
        buf[w & 1023] = i;
        w = w + 1;
        atomic_store_release(&write_idx, w);
        i = i + 1;
    }
    return 0;
}

fn main() -> i64 {
    thread_spawn(&producer, stack + 65536, &tid);
    let r = 0;
    let sum = 0;
    let got = 0;
    while (got < 1000000) {
        let wr = atomic_load_acquire(&write_idx);
        if (r == wr) {
            cpu_pause();
        } else {
            sum = sum + buf[r & 1023];
            r = r + 1;
            atomic_store_release(&read_idx, r);
            got = got + 1;
        }
    }
    thread_join(&tid);
    print_int(sum);
    println("");
    return 0;
}
