// MPMC ring. Two producers, two consumers. Capacity 1024.
// One producer pushes 1..500000, the other 500001..1000000.
// Sum is 500000500000.
align(64) struct Cell {
    volatile seq: u64,
    volatile data: u64,
}

let cells: [Cell; 1024];
align(64) let volatile enq: u64 = 0;
align(64) let volatile deq: u64 = 0;
align(64) let volatile done: u64 = 0;
let volatile next_id: u64 = 0;
let sum0: u64 = 0;
let sum1: u64 = 0;
let volatile tid0: u32 = 0;
let volatile tid1: u32 = 0;
let volatile tid2: u32 = 0;
let volatile tid3: u32 = 0;
let stack0: [u8; 65536];
let stack1: [u8; 65536];
let stack2: [u8; 65536];
let stack3: [u8; 65536];

fn try_push(v: i64) -> i64 {
    let pos = 0;
    let seq = 0;
    let again = 0;
    let old = 0;
    while (1) {
        pos = atomic_load_acquire(&enq);
        seq = atomic_load_acquire(&cells[pos & 1023].seq);
        if (seq != pos) {
            again = atomic_load_acquire(&enq);
            if (again == pos) {
                return 0;
            }
        } else {
            old = compare_exchange(&enq, pos, pos + 1);
            if (old == pos) {
                cells[pos & 1023].data = v;
                atomic_store_release(&cells[pos & 1023].seq, pos + 1);
                return 1;
            }
        }
    }
    return 0;
}

fn try_pop() -> i64 {
    let pos = 0;
    let seq = 0;
    let again = 0;
    let old = 0;
    let v = 0;
    while (1) {
        pos = atomic_load_acquire(&deq);
        seq = atomic_load_acquire(&cells[pos & 1023].seq);
        if (seq != pos + 1) {
            again = atomic_load_acquire(&deq);
            if (again == pos) {
                return 0;
            }
        } else {
            old = compare_exchange(&deq, pos, pos + 1);
            if (old == pos) {
                v = cells[pos & 1023].data;
                atomic_store_release(&cells[pos & 1023].seq, pos + 1024);
                return v;
            }
        }
    }
    return 0;
}

fn push_range(lo: i64, hi: i64) -> i64 {
    let i = lo;
    while (i <= hi) {
        while (try_push(i) == 0) {
            cpu_pause();
        }
        i = i + 1;
    }
    return 0;
}

fn prod_lo() -> i64 {
    return push_range(1, 500000);
}

fn prod_hi() -> i64 {
    return push_range(500001, 1000000);
}

fn consumer() -> i64 {
    let id = fetch_add(&next_id, 1);
    let sum = 0;
    let v = 0;
    while (1) {
        v = try_pop();
        if (v != 0) {
            sum = sum + v;
        } else {
            if (atomic_load_acquire(&done) != 0) {
                v = try_pop();
                if (v == 0) {
                    if (id == 0) { sum0 = sum; }
                    else { sum1 = sum; }
                    return 0;
                }
                sum = sum + v;
            } else {
                cpu_pause();
            }
        }
    }
    return 0;
}

fn main() -> i64 {
    let i = 0;
    while (i < 1024) {
        atomic_store_release(&cells[i].seq, i);
        i = i + 1;
    }
    thread_spawn(&prod_lo, stack0 + 65536, &tid0);
    thread_spawn(&prod_hi, stack1 + 65536, &tid1);
    thread_spawn(&consumer, stack2 + 65536, &tid2);
    thread_spawn(&consumer, stack3 + 65536, &tid3);
    thread_join(&tid0);
    thread_join(&tid1);
    atomic_store_release(&done, 1);
    thread_join(&tid2);
    thread_join(&tid3);
    print_int(sum0 + sum1);
    println("");
    return 0;
}
