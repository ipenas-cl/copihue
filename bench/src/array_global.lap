// BENCH: array n=100000 rounds=1000
// Same algorithm as array.lap, but the array is global.
// Copihue checks bounds on local-array reads and not on global-array reads.
// This file is only compared against itself and against array.lap's output.
let a: [i64; 100000];

fn main() -> i32 {
    let n = 100000;
    let rounds = 1000;
    let i = 0;
    let v = 0;
    let sum = 0;
    let round = 0;
    while (i < n) {
        a[i] = (i * 3 + 1) & 1023;
        i = i + 1;
    }
    while (round < rounds) {
        i = 0;
        while (i < n) {
            v = a[i];
            a[i] = (v * 3 + (i & 7) + 1) & 1023;
            i = i + 1;
        }
        round = round + 1;
    }
    i = 0;
    while (i < n) {
        sum = sum + a[i] * (i + 1);
        i = i + 1;
    }
    print_int(sum);
    println("");
    return 0;
}
