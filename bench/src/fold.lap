// BENCH: fold n=500000000
// Reducible loop: s = sum_{i=0}^{n-1} (3*i + 1).
// Other compilers may evaluate this at compile time. Copihue runs the loop.
fn main() -> i32 {
    let n = 500000000;
    let s = 0;
    let i = 0;
    while (i < n) {
        s = s + i * 3 + 1;
        i = i + 1;
    }
    print_int(s);
    println("");
    return 0;
}
