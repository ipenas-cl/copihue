// BENCH: sort n=28000
// Insertion sort. Checksum sum of a[i] * (i + 1) depends on the final order.
// `&&` must short-circuit so a[-1] is never read.
fn main() -> i32 {
    let n = 28000;
    let a: [i64; 28000];
    let i = 0;
    let j = 0;
    let key = 0;
    let sum = 0;
    while (i < n) {
        a[i] = (i * 97 + 13) & 4095;
        i = i + 1;
    }
    i = 1;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        sum = sum + a[i] * (i + 1);
        i = i + 1;
    }
    print_int(sum);
    println("");
    return 0;
}
