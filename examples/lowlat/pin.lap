// sched_setaffinity de la hebra actual. cpu 1024 no entra en la máscara
// de 1024 bits y devuelve -1 sin llamar al kernel. Dos hebras se fijan
// a cpu 0 y cpu 1 y cada una incrementa su contador, en líneas distintas.
align(64) struct Line {
    align(64) volatile a: u64,
    align(64) volatile b: u64,
}
let line: Line;
let volatile tid1: u32 = 0;
let volatile tid2: u32 = 0;
let stack1: [u8; 65536];
let stack2: [u8; 65536];
let volatile pa: i64 = 0;
let volatile pb: i64 = 0;

fn on0() -> i64 {
    let i = 0;
    pa = sched_setaffinity(0);
    while (i < 1000) {
        fetch_add(&line.a, 1);
        i = i + 1;
    }
    return 0;
}
fn on1() -> i64 {
    let i = 0;
    pb = sched_setaffinity(1);
    while (i < 1000) {
        fetch_add(&line.b, 1);
        i = i + 1;
    }
    return 0;
}

fn main() -> i32 {
    print("self ");
    print_int(sched_setaffinity(0));
    println("");
    print("bad ");
    print_int(sched_setaffinity(1024));
    println("");
    thread_spawn(&on0, stack1 + 65536, &tid1);
    thread_spawn(&on1, stack2 + 65536, &tid2);
    thread_join(&tid1);
    thread_join(&tid2);
    print("cpu0 ");
    print_int(pa);
    println("");
    print("cpu1 ");
    print_int(pb);
    println("");
    print_int(atomic_load_acquire(&line.a) + atomic_load_acquire(&line.b));
    println("");
    return 0;
}
