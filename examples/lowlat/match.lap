// Motor: límite y mercado sobre el libro. Precio primero, tiempo dentro del nivel.
struct Order { id: i32, qty: i32, next: i32 }
struct Level { price: i32, head: i32, tail: i32, live: u8 }

let orders: [Order; 8];
let bids: [Level; 4];
let asks: [Level; 4];
let free_ord: i32 = 0;
let nbid: i32 = 0;
let nask: i32 = 0;

fn book_init() -> i64 {
    let i = 0;
    while (i < 8) {
        orders[i].id = 0;
        orders[i].qty = 0;
        orders[i].next = (i + 1) as i32;
        i = i + 1;
    }
    orders[7].next = -1;
    free_ord = 0;
    nbid = 0;
    nask = 0;
    return sizeof(Order) * 100 + sizeof(Level);
}

fn take() -> i32 {
    let oi: i32 = free_ord;
    if (oi < 0) { return -1; }
    free_ord = orders[oi].next;
    return oi;
}

fn give(oi: i32) -> i64 {
    orders[oi].id = 0;
    orders[oi].qty = 0;
    orders[oi].next = free_ord;
    free_ord = oi;
    return 0;
}

fn find_level(side: i64, price: i64) -> i32 {
    let n = nbid;
    let i = 0;
    if (side != 0) { n = nask; }
    while (i < n) {
        if (side == 0) {
            if (bids[i].price == price) { return i as i32; }
        } else {
            if (asks[i].price == price) { return i as i32; }
        }
        i = i + 1;
    }
    return -1;
}

fn add_level(side: i64, price: i64) -> i32 {
    let n = nbid;
    if (side != 0) { n = nask; }
    if (n >= 4) { return -1; }
    if (side == 0) {
        bids[n].price = price as i32;
        bids[n].head = -1;
        bids[n].tail = -1;
        bids[n].live = 1;
        nbid = (n + 1) as i32;
    } else {
        asks[n].price = price as i32;
        asks[n].head = -1;
        asks[n].tail = -1;
        asks[n].live = 1;
        nask = (n + 1) as i32;
    }
    return n as i32;
}

fn drop_level(side: i64, li: i32) -> i64 {
    let n = nbid;
    let last = 0;
    if (side != 0) { n = nask; }
    last = n - 1;
    if (li != last) {
        if (side == 0) { bids[li] = bids[last]; }
        else { asks[li] = asks[last]; }
    }
    if (side == 0) { nbid = last as i32; }
    else { nask = last as i32; }
    return 0;
}

fn insert(side: i64, id: i64, price: i64, qty: i64) -> i64 {
    let li: i32 = find_level(side, price);
    let oi: i32 = 0;
    if (li < 0) {
        li = add_level(side, price);
        if (li < 0) { return 2; }
    }
    oi = take();
    if (oi < 0) { return 3; }
    orders[oi].id = id as i32;
    orders[oi].qty = qty as i32;
    orders[oi].next = -1;
    if (side == 0) {
        if (bids[li].head < 0) {
            bids[li].head = oi;
            bids[li].tail = oi;
        } else {
            orders[bids[li].tail].next = oi;
            bids[li].tail = oi;
        }
    } else {
        if (asks[li].head < 0) {
            asks[li].head = oi;
            asks[li].tail = oi;
        } else {
            orders[asks[li].tail].next = oi;
            asks[li].tail = oi;
        }
    }
    return 0;
}

fn cancel(id: i64) -> i64 {
    let side = 0;
    while (side < 2) {
        let n = nbid;
        let li = 0;
        if (side != 0) { n = nask; }
        while (li < n) {
            let prev = -1;
            let cur = 0;
            if (side == 0) { cur = bids[li].head; }
            else { cur = asks[li].head; }
            while (cur >= 0) {
                if (orders[cur].id == id) {
                    let nxt: i32 = orders[cur].next;
                    if (prev < 0) {
                        if (side == 0) { bids[li].head = nxt; }
                        else { asks[li].head = nxt; }
                    } else {
                        orders[prev].next = nxt;
                    }
                    if (side == 0) {
                        if (bids[li].tail == cur) { bids[li].tail = prev as i32; }
                        if (bids[li].head < 0) { drop_level(0, li as i32); }
                    } else {
                        if (asks[li].tail == cur) { asks[li].tail = prev as i32; }
                        if (asks[li].head < 0) { drop_level(1, li as i32); }
                    }
                    give(cur as i32);
                    return 0;
                }
                prev = cur;
                cur = orders[cur].next;
            }
            li = li + 1;
        }
        side = side + 1;
    }
    return 1;
}

fn best_bid() -> i64 {
    let i = 0;
    let best = 0;
    let seen = 0;
    while (i < nbid) {
        let px = bids[i].price;
        if (seen == 0 || px > best) { best = px; seen = 1; }
        i = i + 1;
    }
    return best;
}

fn best_ask() -> i64 {
    let i = 0;
    let best = 0;
    let seen = 0;
    while (i < nask) {
        let px = asks[i].price;
        if (seen == 0 || px < best) { best = px; seen = 1; }
        i = i + 1;
    }
    return best;
}

fn best_bid_li() -> i32 {
    let i = 0;
    let best = 0;
    let at: i32 = -1;
    while (i < nbid) {
        let px = bids[i].price;
        if (at < 0 || px > best) { best = px; at = i as i32; }
        i = i + 1;
    }
    return at;
}

fn best_ask_li() -> i32 {
    let i = 0;
    let best = 0;
    let at: i32 = -1;
    while (i < nask) {
        let px = asks[i].price;
        if (at < 0 || px < best) { best = px; at = i as i32; }
        i = i + 1;
    }
    return at;
}

fn cross(is_buy: i64, limit_px: i64, qty: i64, is_market: i64, taker: i64) -> i64 {
    let left = qty;
    let go = 1;
    while (left > 0 && go == 1) {
        let li: i32 = -1;
        let px = 0;
        let oi: i32 = -1;
        if (is_buy != 0) { li = best_ask_li(); }
        else { li = best_bid_li(); }
        if (li < 0) {
            go = 0;
        } else {
            if (is_buy != 0) {
                px = asks[li].price;
                oi = asks[li].head;
            } else {
                px = bids[li].price;
                oi = bids[li].head;
            }
            if (is_market == 0) {
                if (is_buy != 0 && px > limit_px) { go = 0; }
                if (is_buy == 0 && px < limit_px) { go = 0; }
            }
            if (go == 1) {
                let avail = orders[oi].qty;
                let takeq = left;
                let maker = orders[oi].id;
                if (takeq > avail) { takeq = avail; }
                print("trade ");
                print_int(taker);
                print(" ");
                print_int(maker);
                print(" ");
                print_int(px);
                print(" ");
                print_int(takeq);
                println("");
                orders[oi].qty = (avail - takeq) as i32;
                left = left - takeq;
                if (orders[oi].qty == 0) { cancel(maker); }
            }
        }
    }
    return left;
}

fn limit(side: i64, id: i64, price: i64, qty: i64) -> i64 {
    let is_buy = 0;
    let left = 0;
    if (side == 0) { is_buy = 1; }
    left = cross(is_buy, price, qty, 0, id);
    if (left > 0) {
        insert(side, id, price, left);
        print("rest ");
        print_int(id);
        print(" ");
        print_int(price);
        print(" ");
        print_int(left);
        println("");
    }
    return left;
}

fn market(side: i64, id: i64, qty: i64) -> i64 {
    let is_buy = 0;
    let left = 0;
    if (side == 0) { is_buy = 1; }
    left = cross(is_buy, 0, qty, 1, id);
    print("mkt ");
    print_int(id);
    print(" ");
    print_int(left);
    println("");
    return left;
}

fn main() -> i32 {
    print("size ");
    print_int(sizeof(Order));
    print(" ");
    print_int(sizeof(Level));
    println("");
    book_init();
    limit(0, 9, 90, 1);
    limit(1, 1, 100, 5);
    limit(1, 2, 101, 4);
    limit(1, 3, 100, 3);
    limit(0, 4, 100, 6);
    limit(0, 5, 101, 10);
    market(1, 6, 3);
    market(0, 7, 5);
    print("miss ");
    print_int(cancel(99));
    println("");
    print("bid ");
    print_int(best_bid());
    println("");
    print("ask ");
    print_int(best_ask());
    println("");
    print("cancel ");
    print_int(cancel(5));
    println("");
    print("bid ");
    print_int(best_bid());
    println("");
    print("ask ");
    print_int(best_ask());
    println("");
    return 0;
}
