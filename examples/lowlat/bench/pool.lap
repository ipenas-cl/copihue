// BENCH: pool CAP=1024 REPS=4000
// Misma lista libre de punteros que examples/lowlat/pool.lap.
// BENCH pool CAP=1024 REPS=4000
struct Block { next: *Block, tag: u8, val: i64 }
let slots: [Block; 1024];
let free_head: *Block = 0;

fn init() -> i64 {
    let i = 0;
    free_head = 0;
    while (i < 1024) {
        slots[i].tag = 0;
        slots[i].val = 0;
        slots[i].next = free_head;
        free_head = &slots[i];
        i = i + 1;
    }
    return 0;
}

fn alloc() -> *Block {
    let p = free_head;
    if (p == 0) { return 0; }
    free_head = p->next;
    p->next = 0;
    p->tag = 1;
    return p;
}

fn release(p: *Block) -> i64 {
    p->tag = 0;
    p->next = free_head;
    free_head = p;
    return 0;
}

fn main() -> i32 {
    let rep = 0;
    let acc = 0;
    init();
    while (rep < 4000) {
        let i = 0;
        while (i < 1024) {
            let p = alloc();
            p->val = i + 1;
            i = i + 1;
        }
        if (alloc() == 0) { acc = acc + 1; }
        i = 0;
        while (i < 1024) {
            acc = acc + slots[i].val;
            release(&slots[i]);
            i = i + 1;
        }
        rep = rep + 1;
    }
    print_int(acc & 16777215);
    println("");
    return 0;
}
