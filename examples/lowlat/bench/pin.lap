// BENCH: pin N=4000000 cpus=0,1
align(64) struct Line {
    align(64) volatile a: u64,
    align(64) volatile b: u64,
}
let line: Line;
let volatile tid1: u32 = 0;
let volatile tid2: u32 = 0;
let stack1: [u8; 65536];
let stack2: [u8; 65536];
let volatile pa: i64 = 0;
let volatile pb: i64 = 0;

fn add_a() -> i64 {
    let i = 0;
    pa = sched_setaffinity(0);
    while (i < 4000000) {
        fetch_add(&line.a, 1);
        i = i + 1;
    }
    return 0;
}
fn add_b() -> i64 {
    let i = 0;
    pb = sched_setaffinity(1);
    while (i < 4000000) {
        fetch_add(&line.b, 1);
        i = i + 1;
    }
    return 0;
}
fn main() -> i32 {
    let s = 0;
    thread_spawn(&add_a, stack1 + 65536, &tid1);
    thread_spawn(&add_b, stack2 + 65536, &tid2);
    thread_join(&tid1);
    thread_join(&tid2);
    s = atomic_load_acquire(&line.a) + atomic_load_acquire(&line.b);
    if (pa != 0 || pb != 0) { s = 0; }
    print_int(s);
    println("");
    return 0;
}
