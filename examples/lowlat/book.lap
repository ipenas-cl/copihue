// Libro chico: niveles de precio y órdenes en FIFO por nivel.
struct Order { id: i32, qty: i32, next: i32 }
struct Level { price: i32, head: i32, tail: i32, live: u8 }

let orders: [Order; 8];
let bids: [Level; 4];
let asks: [Level; 4];
let free_ord: i32 = 0;
let nbid: i32 = 0;
let nask: i32 = 0;

fn book_init() -> i64 {
    let i = 0;
    while (i < 8) {
        orders[i].id = 0;
        orders[i].qty = 0;
        orders[i].next = (i + 1) as i32;
        i = i + 1;
    }
    orders[7].next = -1;
    free_ord = 0;
    nbid = 0;
    nask = 0;
    return sizeof(Order) * 100 + sizeof(Level);
}

fn take() -> i32 {
    let oi: i32 = free_ord;
    if (oi < 0) { return -1; }
    free_ord = orders[oi].next;
    return oi;
}

fn give(oi: i32) -> i64 {
    orders[oi].id = 0;
    orders[oi].qty = 0;
    orders[oi].next = free_ord;
    free_ord = oi;
    return 0;
}

fn find_level(side: i64, price: i64) -> i32 {
    let n = nbid;
    let i = 0;
    if (side != 0) { n = nask; }
    while (i < n) {
        if (side == 0) {
            if (bids[i].price == price) { return i as i32; }
        } else {
            if (asks[i].price == price) { return i as i32; }
        }
        i = i + 1;
    }
    return -1;
}

fn add_level(side: i64, price: i64) -> i32 {
    let n = nbid;
    if (side != 0) { n = nask; }
    if (n >= 4) { return -1; }
    if (side == 0) {
        bids[n].price = price as i32;
        bids[n].head = -1;
        bids[n].tail = -1;
        bids[n].live = 1;
        nbid = (n + 1) as i32;
    } else {
        asks[n].price = price as i32;
        asks[n].head = -1;
        asks[n].tail = -1;
        asks[n].live = 1;
        nask = (n + 1) as i32;
    }
    return n as i32;
}

fn drop_level(side: i64, li: i32) -> i64 {
    let n = nbid;
    let last = 0;
    if (side != 0) { n = nask; }
    last = n - 1;
    if (li != last) {
        if (side == 0) { bids[li] = bids[last]; }
        else { asks[li] = asks[last]; }
    }
    if (side == 0) { nbid = last as i32; }
    else { nask = last as i32; }
    return 0;
}

fn insert(side: i64, id: i64, price: i64, qty: i64) -> i64 {
    let li: i32 = find_level(side, price);
    let oi: i32 = 0;
    if (li < 0) {
        li = add_level(side, price);
        if (li < 0) { return 2; }
    }
    oi = take();
    if (oi < 0) { return 3; }
    orders[oi].id = id as i32;
    orders[oi].qty = qty as i32;
    orders[oi].next = -1;
    if (side == 0) {
        if (bids[li].head < 0) {
            bids[li].head = oi;
            bids[li].tail = oi;
        } else {
            orders[bids[li].tail].next = oi;
            bids[li].tail = oi;
        }
    } else {
        if (asks[li].head < 0) {
            asks[li].head = oi;
            asks[li].tail = oi;
        } else {
            orders[asks[li].tail].next = oi;
            asks[li].tail = oi;
        }
    }
    return 0;
}

fn cancel(id: i64) -> i64 {
    let side = 0;
    while (side < 2) {
        let n = nbid;
        let li = 0;
        if (side != 0) { n = nask; }
        while (li < n) {
            let prev = -1;
            let cur = 0;
            if (side == 0) { cur = bids[li].head; }
            else { cur = asks[li].head; }
            while (cur >= 0) {
                if (orders[cur].id == id) {
                    let nxt: i32 = orders[cur].next;
                    if (prev < 0) {
                        if (side == 0) { bids[li].head = nxt; }
                        else { asks[li].head = nxt; }
                    } else {
                        orders[prev].next = nxt;
                    }
                    if (side == 0) {
                        if (bids[li].tail == cur) { bids[li].tail = prev as i32; }
                        if (bids[li].head < 0) { drop_level(0, li as i32); }
                    } else {
                        if (asks[li].tail == cur) { asks[li].tail = prev as i32; }
                        if (asks[li].head < 0) { drop_level(1, li as i32); }
                    }
                    give(cur as i32);
                    return 0;
                }
                prev = cur;
                cur = orders[cur].next;
            }
            li = li + 1;
        }
        side = side + 1;
    }
    return 1;
}

fn best_bid() -> i64 {
    let i = 0;
    let best = 0;
    let seen = 0;
    while (i < nbid) {
        let px = bids[i].price;
        if (seen == 0 || px > best) { best = px; seen = 1; }
        i = i + 1;
    }
    return best;
}

fn best_ask() -> i64 {
    let i = 0;
    let best = 0;
    let seen = 0;
    while (i < nask) {
        let px = asks[i].price;
        if (seen == 0 || px < best) { best = px; seen = 1; }
        i = i + 1;
    }
    return best;
}

fn show() -> i64 {
    print("book ");
    print_int(best_bid());
    print(" ");
    print_int(best_ask());
    println("");
    return 0;
}

fn report_cancel(id: i64) -> i64 {
    let rc = cancel(id);
    if (rc == 0) { print("cancel "); }
    else { print("miss "); }
    print_int(id);
    println("");
    return rc;
}

fn main() -> i32 {
    book_init();
    print("size ");
    print_int(sizeof(Order));
    print(" ");
    print_int(sizeof(Level));
    println("");
    insert(0, 1, 100, 5);
    insert(0, 2, 101, 3);
    insert(0, 3, 101, 4);
    insert(1, 4, 105, 2);
    insert(1, 5, 103, 7);
    show();
    report_cancel(2);
    show();
    report_cancel(99);
    report_cancel(1);
    show();
    report_cancel(3);
    show();
    report_cancel(4);
    show();
    return 0;
}
