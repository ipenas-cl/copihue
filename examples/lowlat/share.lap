// Dos contadores. Cada hebra hace fetch_add solo del suyo.
// Near cabe en una línea de 64. Far separa los campos con align(64).
// N es chico: el tiempo está en bench/share.lap y bench/split.lap.
align(64) struct Near {
    volatile a: u64,
    volatile b: u64,
}
align(64) struct Far {
    align(64) volatile a: u64,
    align(64) volatile b: u64,
}
let row: Near;
let gap: Far;
let volatile tid1: u32 = 0;
let volatile tid2: u32 = 0;
let stack1: [u8; 65536];
let stack2: [u8; 65536];

fn row_a() -> i64 {
    let i = 0;
    while (i < 1000) {
        fetch_add(&row.a, 1);
        i = i + 1;
    }
    return 0;
}
fn row_b() -> i64 {
    let i = 0;
    while (i < 1000) {
        fetch_add(&row.b, 1);
        i = i + 1;
    }
    return 0;
}
fn gap_a() -> i64 {
    let i = 0;
    while (i < 1000) {
        fetch_add(&gap.a, 1);
        i = i + 1;
    }
    return 0;
}
fn gap_b() -> i64 {
    let i = 0;
    while (i < 1000) {
        fetch_add(&gap.b, 1);
        i = i + 1;
    }
    return 0;
}

fn main() -> i32 {
    print("share ");
    print_int(sizeof(Near));
    println("");
    thread_spawn(&row_a, stack1 + 65536, &tid1);
    thread_spawn(&row_b, stack2 + 65536, &tid2);
    thread_join(&tid1);
    thread_join(&tid2);
    print_int(atomic_load_acquire(&row.a) + atomic_load_acquire(&row.b));
    println("");

    print("split ");
    print_int(sizeof(Far));
    println("");
    thread_spawn(&gap_a, stack1 + 65536, &tid1);
    thread_spawn(&gap_b, stack2 + 65536, &tid2);
    thread_join(&tid1);
    thread_join(&tid2);
    print_int(atomic_load_acquire(&gap.a) + atomic_load_acquire(&gap.b));
    println("");
    return 0;
}
