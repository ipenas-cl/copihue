// Greatest Common Divisor (GCD) - Euclidean Algorithm
// Demonstrates: recursive algorithms, mathematical computation

fn gcd(a: i64, b: i64) -> i64 {
    if (b == 0) {
        return a;
    }
    return gcd(b, a % b);
}

fn lcm(a: i64, b: i64) -> i64 {
    return (a * b) / gcd(a, b);
}

fn main() -> i64 {
    let a = 48;
    let b = 18;

    print("GCD of ");
    print_int(a);
    print(" and ");
    print_int(b);
    print(" = ");
    print_int(gcd(a, b));
    println("");

    print("LCM of ");
    print_int(a);
    print(" and ");
    print_int(b);
    print(" = ");
    print_int(lcm(a, b));
    println("");

    return gcd(a, b);
}
