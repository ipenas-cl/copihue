// also-o2
// ltr loads a TSS selector. syscall MSRs are ordinary wrmsr values:
// EFER 0xC0000080 (SCE is bit 0), STAR 0xC0000081, LSTAR 0xC0000082,
// SFMASK 0xC0000084. interrupt fn already ends in iretq, which returns
// to ring 3 when the CPU frame's CS.RPL is 3. syscall fn ends in
// `o64 sysret` (NASM's sysretq). iretq() and sysretq() are the same
// instructions for a frame the kernel built itself.
packed struct Tss {
    reserved0: u32,
    rsp0: u64,
    rsp1: u64,
    rsp2: u64,
    reserved1: u64,
    ist1: u64,
    ist2: u64,
    ist3: u64,
    ist4: u64,
    ist5: u64,
    ist6: u64,
    ist7: u64,
    reserved2: u64,
    reserved3: u16,
    iomap: u16
}

let tss: Tss;
let cur: i64;

fn set_rsp0(sp: i64) -> i64 {
    tss.rsp0 = sp;
    tss.ist1 = sp;
    return tss.rsp0;
}

fn program_syscall(entry: i64) -> i64 {
    let efer = rdmsr(0xC0000080);
    wrmsr(0xC0000080, efer | 1);
    wrmsr(0xC0000081, 0x0010000800000000);
    wrmsr(0xC0000082, entry);
    wrmsr(0xC0000084, 0x200);
    ltr(0x28);
    return set_rsp0(0x7000);
}

interrupt fn fault(err: i64) {
    cur = tss.rsp0;
    cur = err;
}

syscall fn sys_write(nr: i64, ch: i64) -> i64 {
    return ch;
}

fn enter_ring3() -> i64 {
    iretq();
    return 0;
}

fn raw_sysret() -> i64 {
    sysretq();
    return 0;
}

fn kmain() -> i64 {
    return program_syscall(&sys_write);
}
