// Flat kernel loaded at 0x8000 by tests/usermode/boot.lap. _start is still
// 32-bit: it builds an identity map of the first 2MB, sets EFER.LME, and
// far-jumps into kmain. The 2MB page is user-accessible so ring 3 can
// fetch its own instructions; a real kernel would split that mapping. kmain writes the TSS, loads it with ltr, programs
// STAR/LSTAR/SFMASK/EFER.SCE, and iretq's to ring 3.
//
// GDT (this image's, not AtomicOS and not the boot sector's):
//   0x08 kernel code 64, 0x10 kernel data,
//   0x18 user data, 0x20 user code 64, 0x28 16-byte TSS.
// STAR 0x0010000800000000 makes SYSCALL use 0x08/0x10 and SYSRET use
// 0x23/0x1B. Stacks are fixed physical pages so the tops are 16-aligned:
//   user 0x5000, syscall 0x6000, rsp0 0x7000, then 0x7800 after the switch.
// COM1 should show USER: syscall, int 0x80, syscall, int 0x80 on the new rsp0.

packed struct Tss {
    reserved0: u32,
    rsp0: u64,
    rsp1: u64,
    rsp2: u64,
    reserved1: u64,
    ist1: u64,
    ist2: u64,
    ist3: u64,
    ist4: u64,
    ist5: u64,
    ist6: u64,
    ist7: u64,
    reserved2: u64,
    reserved3: u16,
    iomap: u16
}

packed struct IdtEntry {
    off_lo: u16,
    sel: u16,
    ist: u8,
    typ: u8,
    off_mid: u16,
    off_hi: u32,
    zero: u32
}

packed struct DescPtr { limit: u16, base: u64 }

let tss: Tss;
let idt: [IdtEntry; 129];
let which: i64;

data gdt {
    dq 0;
    dw 0;
    dw 0;
    db 0;
    db 0x9A;
    db 0x20;
    db 0;
    dw 0xFFFF;
    dw 0;
    db 0;
    db 0x92;
    db 0xCF;
    db 0;
    dw 0xFFFF;
    dw 0;
    db 0;
    db 0xF2;
    db 0xCF;
    db 0;
    dw 0;
    dw 0;
    db 0;
    db 0xFA;
    db 0x20;
    db 0;
    tss_desc:
    dw 103;
    dw 0;
    db 0;
    db 0x89;
    db 0;
    db 0;
    dd 0;
    dd 0;
}

data gdtr {
    dw 55;
    dd gdt;
}

fn zero_bytes(p: *u8, n: i64) -> i64 {
    let i = 0;
    while (i < n) {
        p[i] = 0;
        i = i + 1;
    }
    return 0;
}

fn serial_putc(c: i64) -> i64 {
    let tries = 0;
    while ((inb(0x3FD) & 0x20) == 0 && tries < 1000) { tries = tries + 1; }
    outb(0x3F8, c);
    return 0;
}

fn set_gate(n: i64, handler: i64) -> i64 {
    idt[n].off_lo = handler & 0xFFFF;
    idt[n].sel = 0x08;
    idt[n].ist = 0;
    idt[n].typ = 0xEE;
    idt[n].off_mid = (handler >> 16) & 0xFFFF;
    idt[n].off_hi = handler >> 32;
    idt[n].zero = 0;
    return 0;
}

interrupt fn user_int() {
    asm("mov rax, rbp");
    asm("cmp rax, 0x7000");
    asm("jb .not2");
    asm("cmp rax, 0x7800");
    asm("jae .not2");
    asm("mov byte [which], 1");
    asm(".not2:");
    if (which == 1) {
        serial_putc(82);
        hlt();
    }
    serial_putc(83);
}

syscall fn sys_call(nr: i64, ch: i64) -> i64 {
    if (nr == 2) { tss.rsp0 = 0x7800; }
    serial_putc(ch);
    return 0;
}

naked fn user_code() {
    asm("mov rax, 1");
    asm("mov rdi, 85");
    asm("syscall");
    int(0x80);
    asm("mov rax, 2");
    asm("mov rdi, 69");
    asm("syscall");
    int(0x80);
    hlt();
}

fn kmain() -> i64 {
    zero_bytes(&tss as *u8, 104);
    zero_bytes(&idt as *u8, 2064);
    which = 0;
    tss.rsp0 = 0x7000;
    tss.ist1 = 0x6000;
    tss.iomap = 104;
    asm("lea rdi, [tss_desc]");
    asm("lea rax, [tss]");
    asm("mov [rdi+2], ax");
    asm("shr rax, 16");
    asm("mov [rdi+4], al");
    asm("shr rax, 8");
    asm("mov [rdi+7], al");
    asm("shr rax, 8");
    asm("mov [rdi+8], eax");
    ltr(0x28);
    set_syscall_stack(0x6000);
    let efer = rdmsr(0xC0000080);
    wrmsr(0xC0000080, efer | 1);
    wrmsr(0xC0000081, 0x0010000800000000);
    wrmsr(0xC0000082, &sys_call);
    wrmsr(0xC0000084, 0x200);
    set_gate(128, &user_int);
    let idtr: DescPtr;
    idtr.limit = 2063;
    idtr.base = idt as u64;
    lidt(&idtr);
    asm("push 0x1B");
    asm("push 0x5000");
    asm("push 0x2");
    asm("push 0x23");
    asm("push user_code");
    iretq();
    return 0;
}

bits 32 naked fn _start() {
    cli();
    asm("lgdt [gdtr]");
    asm("mov ax, 0x10");
    asm("mov ds, ax");
    asm("mov es, ax");
    asm("mov ss, ax");
    asm("mov esp, 0x6000");
    asm("cld");
    asm("xor eax, eax");
    asm("mov edi, 0x1000");
    asm("mov ecx, 3072");
    asm("rep stosd");
    asm("mov dword [0x1000], 0x2007");
    asm("mov dword [0x2000], 0x3007");
    asm("mov dword [0x3000], 0x87");
    asm("mov eax, cr4");
    asm("or eax, 0x20");
    asm("mov cr4, eax");
    asm("mov eax, 0x1000");
    asm("mov cr3, eax");
    asm("mov ecx, 0xC0000080");
    asm("rdmsr");
    asm("or eax, 0x100");
    asm("wrmsr");
    asm("mov eax, cr0");
    asm("or eax, 0x80000000");
    asm("mov cr0, eax");
    asm("jmp 0x08:kmain");
}
