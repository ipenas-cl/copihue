// Smallest kernel surface Copihue can compile on its own: boot, serial,
// a bump allocator, a packed IDT, an interrupt handler and a syscall entry.
// Loaded at 0x10000 by a long-mode stub. No hosted runtime.
//
// The IDT code selector is 0x18, the 64-bit code segment of the AtomicOS
// bootloader GDT. That loader's 32-bit code segment is 0x08; a gate that
// uses 0x08 drops out of 64-bit mode and the image hangs. This binary
// assumes that GDT is already loaded. It is not a generic bootable kernel
// and will not run under a loader with a different GDT.

packed struct IdtEntry {
    off_lo: u16,
    sel: u16,
    ist: u8,
    typ: u8,
    off_mid: u16,
    off_hi: u32,
    zero: u32
}

packed struct DescPtr { limit: u16, base: u64 }

let volatile ticks: i64 = 0;
let hp: i64 = 0;
let heap: [u8; 128];
let idt: [IdtEntry; 32];
let kstack: [u8; 256];
let regs: [u32; 2];

packed struct Rec { a: u8, b: u8, c: u8 }

fn exercise() -> i64 {
    let tmp: [i64; 2];
    tmp[0] = 1;
    tmp[1] = 2;
    let s: Rec;
    s.a = 1;
    s.b = 2;
    s.c = 3;
    let t: Rec;
    t = s;
    let p: *volatile u32 = regs;
    p[0] = t.a;
    p[1] = read_cr2() as u32;
    return tmp[0] + tmp[1] + p[0];
}

fn alloc(n: i64) -> i64 {
    if (hp + n > 128) { return 0; }
    let p = heap + hp;
    hp = hp + n;
    return p;
}

fn serial_putc(c: i64) -> i64 {
    let tries = 0;
    while ((inb(0x3FD) & 0x20) == 0 && tries < 1000) { tries = tries + 1; }
    outb(0x3F8, c);
    return 0;
}

interrupt fn timer() {
    ticks = ticks + 1;
    outb(0x20, 0x20);
}

interrupt fn fault(err: i64) {
    ticks = err;
}

syscall fn sys_write(nr: i64, ch: i64, a2: i64, a3: i64, a4: i64, a5: i64) -> i64 {
    if (nr == 1) { serial_putc(ch); return 0; }
    return nr;
}

fn set_gate(n: i64, handler: i64) -> i64 {
    idt[n].off_lo = (handler & 0xFFFF) as u16;
    idt[n].sel = 0x18;
    idt[n].ist = 0;
    idt[n].typ = 0x8E;
    idt[n].off_mid = ((handler >> 16) & 0xFFFF) as u16;
    idt[n].off_hi = (handler >> 32) as u32;
    idt[n].zero = 0;
    return 0;
}

fn _start() -> i64 {
    let bss: *u8 = bss_start();
    let n: i64 = bss_end() - bss_start();
    let i: i64 = 0;
    while (i < n) {
        bss[i] = 0;
        i = i + 1;
    }
    exercise();
    set_syscall_stack(kstack + 256);
    set_gate(32, &timer);
    let idtr: DescPtr;
    idtr.limit = (32 * 16 - 1) as u16;
    idtr.base = idt as u64;
    lidt(&idtr);
    let buf = alloc(8);
    let p: *u8 = buf as *u8;
    p[0] = 'A';
    serial_putc(p[0]);
    while (1) { hlt(); }
    return 0;
}
