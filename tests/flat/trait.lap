// also-o2
trait Ord { fn lt(a: Self, b: Self) -> bool }

impl Ord for i64 {
    fn lt(a: Self, b: Self) -> bool {
        return a < b;
    }
}

fn max<T: Ord>(a: T, b: T) -> T {
    if (a.lt(b)) { return b; }
    return a;
}

fn _start() -> i64 {
    let n = max(3, 9);
    while (1) {
        cli();
        hlt();
    }
    return n;
}
