// also-o2
fn _start() -> i64 {
    let a: [u8; 2] = [104, 105];
    let b: [u8; 2] = [104, 105];
    let s: str = a;
    let t: str = b;
    let n = s.len;
    let c = s[0];
    let u: str = s[0..2];
    let eq = 0;
    if (s == t) {
        eq = 1;
    }
    while (1) {
        cli();
        hlt();
    }
    return n + c + u.len + eq;
}
