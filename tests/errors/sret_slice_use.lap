// What a returned slice is not: an untyped let, an integer, a scalar operand,
// or a slice of another element. `==` compares str and []u8 only.
fn palabra() -> str {
    return "abc";
}

fn nums() -> []i64 {
    return slice(0 as *i64, 0);
}

fn main() -> i32 {
    let a = palabra();
    let n: i64 = palabra();
    let s: str = palabra();
    let same = nums() == nums();
    let t: []i64 = palabra();
    print_int(palabra());
    return 0;
}
