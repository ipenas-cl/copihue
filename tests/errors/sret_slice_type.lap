// The returned value must be a slice of the declared element.
let gb: [u8; 2] = [1, 2];

fn f() -> []i64 {
    return gb;
}

fn g() -> str {
    return 7;
}

fn h(s: str) -> []i64 {
    return s;
}

fn k(n: i64) -> str {
    if (n > 0) { return; }
    return "x";
}

fn main() -> i32 {
    return 0;
}
