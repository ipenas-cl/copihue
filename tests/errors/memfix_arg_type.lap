// A struct parameter takes a struct of that type (0.45.1). The callee copies the
// size of P from the address it gets: before, the 8 bytes of a Q were read as
// 16, and an integer was read as the address.
struct P { x: i64, y: i64 }
struct Q { a: i64 }

fn sum(p: P) -> i64 { return p.x + p.y; }

fn main() -> i32 {
    let q: Q;
    q.a = 1;
    take(sum(q));
    take(sum(5));
    take(sum(Q { a: 2 }));
    return 0;
}

fn take(v: i64) -> i64 { return v; }
