// Test: Pointer modification
fn increment(ptr: *i32) -> i64 {
    let val = *ptr;
    let new_val = val + 1;
    // Note: *ptr = new_val would require assignment through pointer
    // For now, just return the incremented value
    return new_val;
}

fn main() -> i64 {
    let x = 10;
    let result = increment(&x as *i32);

    print_int(result);
    println("");

    return 0;
}
