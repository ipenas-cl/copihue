// Flat kernel at 0x8000 for QEMU, loaded by tests/usermode/boot.lap (16 sectors, 8192 bytes).
// Demonstrates stack probing (0.44.2): the stack top is 0x90000 and the page at 0x88000 is NOT
// PRESENT (a guard page, as AXE2 has under the stack). big() has a 65616-byte frame, which would
// step over that page without touching it. With the probe loop in its prologue the first page it
// lands on faults: #PF has an IST stack, so the handler runs and prints.
//
// _start (32-bit) maps the first 2MB with 4KB pages (PT at 0x4000), unmaps 0x88000, enters long
// mode and far-jumps to kmain. COM1 must show:
//   S      small() (frame under a page) returned the right value
//   PF G   the page fault was taken, and CR2 is inside the guard page
// and NOPF if big() ran to the end without faulting (no probe).

packed struct Tss {
    reserved0: u32,
    rsp0: u64,
    rsp1: u64,
    rsp2: u64,
    reserved1: u64,
    ist1: u64,
    ist2: u64,
    ist3: u64,
    ist4: u64,
    ist5: u64,
    ist6: u64,
    ist7: u64,
    reserved2: u64,
    reserved3: u16,
    iomap: u16
}

packed struct IdtEntry {
    off_lo: u16,
    sel: u16,
    ist: u8,
    typ: u8,
    off_mid: u16,
    off_hi: u32,
    zero: u32
}

packed struct DescPtr { limit: u16, base: u64 }

let tss: Tss;
let idt: [IdtEntry; 16];

data gdt {
    dq 0;
    dw 0;
    dw 0;
    db 0;
    db 0x9A;
    db 0x20;
    db 0;
    dw 0xFFFF;
    dw 0;
    db 0;
    db 0x92;
    db 0xCF;
    db 0;
    tss_desc:
    dw 103;
    dw 0;
    db 0;
    db 0x89;
    db 0;
    db 0;
    dd 0;
    dd 0;
}

data gdtr {
    dw 39;
    dd gdt;
}

fn zero_bytes(p: *u8, n: i64) -> i64 {
    let i = 0;
    while (i < n) {
        p[i] = 0;
        i = i + 1;
    }
    return 0;
}

fn serial_putc(c: i64) -> i64 {
    let tries = 0;
    while ((inb(0x3FD) & 0x20) == 0 && tries < 1000) { tries = tries + 1; }
    outb(0x3F8, c);
    return 0;
}

fn set_gate(n: i64, handler: i64, ist: i64) -> i64 {
    idt[n].off_lo = (handler & 0xFFFF) as u16;
    idt[n].sel = 0x08;
    idt[n].ist = ist as u8;
    idt[n].typ = 0x8E;
    idt[n].off_mid = ((handler >> 16) & 0xFFFF) as u16;
    idt[n].off_hi = (handler >> 32) as u32;
    idt[n].zero = 0;
    return 0;
}

interrupt fn page_fault(err: i64) {
    let at = read_cr2();
    serial_putc(80);
    serial_putc(70);
    if (at >= 0x88000 && at < 0x89000) {
        serial_putc(71);
    } else {
        serial_putc(63);
    }
    while (1) { hlt(); }
}

fn small(n: i64) -> i64 {
    let b: [u8; 256];
    b[0] = 1;
    b[255] = 2;
    return b[0] + b[255] + n;
}

fn big(n: i64) -> i64 {
    let b: [u8; 8192];
    b[0] = 1;
    b[8191] = 2;
    return b[0] + b[8191] + n;
}

fn kmain() -> i64 {
    zero_bytes(&tss as *u8, 104);
    zero_bytes(&idt as *u8, 256);
    tss.ist1 = 0x6F00;
    tss.iomap = 104;
    asm("lea rdi, [tss_desc]");
    asm("lea rax, [tss]");
    asm("mov [rdi+2], ax");
    asm("shr rax, 16");
    asm("mov [rdi+4], al");
    asm("shr rax, 8");
    asm("mov [rdi+7], al");
    asm("shr rax, 8");
    asm("mov [rdi+8], eax");
    ltr(0x18);
    set_gate(14, &page_fault, 1);
    let idtr: DescPtr;
    idtr.limit = 255;
    idtr.base = idt as u64;
    lidt(&idtr);
    if (small(1) == 4) { serial_putc(83); }
    if (big(1) == 4) {
        serial_putc(78);
        serial_putc(79);
        serial_putc(80);
        serial_putc(70);
    }
    while (1) { hlt(); }
    return 0;
}

bits 32 naked fn _start() {
    cli();
    asm("lgdt [gdtr]");
    asm("mov ax, 0x10");
    asm("mov ds, ax");
    asm("mov es, ax");
    asm("mov ss, ax");
    asm("mov esp, 0x90000");
    asm("cld");
    asm("xor eax, eax");
    asm("mov edi, 0x1000");
    asm("mov ecx, 4096");
    asm("rep stosd");
    asm("mov dword [0x1000], 0x2007");
    asm("mov dword [0x2000], 0x3007");
    asm("mov dword [0x3000], 0x4003");
    asm("mov edi, 0x4000");
    asm("mov eax, 3");
    asm("mov ecx, 512");
    asm(".pt:");
    asm("mov [edi], eax");
    asm("add edi, 8");
    asm("add eax, 0x1000");
    asm("dec ecx");
    asm("jnz .pt");
    asm("mov dword [0x4440], 0");
    asm("mov eax, cr4");
    asm("or eax, 0x20");
    asm("mov cr4, eax");
    asm("mov eax, 0x1000");
    asm("mov cr3, eax");
    asm("mov ecx, 0xC0000080");
    asm("rdmsr");
    asm("or eax, 0x100");
    asm("wrmsr");
    asm("mov eax, cr0");
    asm("or eax, 0x80000000");
    asm("mov cr0, eax");
    asm("jmp 0x08:kmain");
}
