// else-if chains.
fn classify(n: i64) -> i64 {
    if (n < 0) {
        println("negative");
    } else if (n == 0) {
        println("zero");
    } else if (n < 10) {
        println("small");
    } else {
        println("large");
    }
    return 0;
}
fn main() -> i32 {
    classify(0 - 5);
    classify(0);
    classify(7);
    classify(100);
    return 0;
}
