// A field read or stored through a pointer that is not a local name (0.45.3): a
// pointer field (`a.next.v`), a global pointer (`gq.y`), an element of an array of
// pointers (`ps[i].x`), and a cast (`(raw as *P).y`). Before, the read loaded
// nothing (the value was whatever rax held) and the store was dropped, with no
// message: b.v and r.x kept 2 and 6.
struct P { x: i64, y: i64 }
struct N { v: i64, next: *N }
struct Box { ps: [*P; 2] }

let gq: *P = 0;

fn show(v: i64) -> i64 {
    print_int(v);
    println("");
    return 0;
}

fn main() -> i32 {
    let a: N;
    let b: N;
    let c: N;
    a.v = 1;
    b.v = 2;
    c.v = 3;
    a.next = &b;
    b.next = &c;
    c.next = 0;
    show(a.next.v);
    show(a.next.next.v);
    a.next.v = 20;
    a.next.next.v = 30;
    show(b.v);
    show(c.v);

    let p: P;
    let r: P;
    p.x = 4;
    p.y = 5;
    r.x = 6;
    r.y = 7;
    gq = &p;
    show(gq.y);
    gq.y = 50;
    show(p.y);

    let ps: [*P; 2];
    let i: i64 = 1;
    ps[0] = &p;
    ps[i] = &r;
    show(ps[i].y);
    ps[i].x = 60;
    show(r.x);

    let raw: i64 = &r as i64;
    show((raw as *P).y);

    let bx: Box;
    bx.ps[0] = &p;
    bx.ps[1] = &r;
    show(bx.ps[i].y);
    return 0;
}
