// for loops with i++ / +=, break and continue (continue still runs the increment).
fn main() -> i32 {
    let s = 0;
    for (let i = 0; i < 10; i++) {
        if (i == 3) { continue; }
        if (i == 7) { break; }
        s = s + i;
    }
    print_int(s); println("");
    let n = 0;
    while (1) { n += 2; if (n > 9) { break; } }
    print_int(n); println("");
    for (let j = 0; j < 6; j += 3) { print_int(j); }
    println("");
    return 0;
}
