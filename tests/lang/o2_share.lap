// Hosted -O2 may put two scalars in one register when liveness says they
// are never live together. A name used by a loop is live through the body,
// including across a call. own *T stays live until it is dropped.
// -O0 and -O2 print the same lines.

fn add1(x: i64) -> i64 {
    return x + 1;
}

fn sum_loop(n: i64) -> i64 {
    let s = 0;
    let i = 0;
    while (i < n) {
        let t = i + 1;
        s = s + add1(t);
        i = i + 1;
    }
    return s;
}

fn scan(id: i64, n: i64) -> i64 {
    let acc = 0;
    let i = 0;
    let side = 1;
    while (i < n) {
        let cur = i;
        let prev = side;
        if (cur == id) {
            let nxt = cur + 7;
            return acc + add1(nxt);
        }
        acc = acc + cur + prev;
        i = i + 1;
    }
    return acc;
}

fn nest(n: i64) -> i64 {
    let s = 0;
    let i = 0;
    while (i < n) {
        let j = 0;
        while (j < n) {
            s = s + add1(i + j);
            j = j + 1;
        }
        i = i + 1;
    }
    return s;
}

fn pick(a: i64, b: i64) -> i64 {
    let r = 0;
    if (a < b) {
        let x = add1(a);
        r = x;
    } else {
        let y = add1(b);
        r = y + 2;
    }
    return r + a;
}

fn across(a: i64) -> i64 {
    let b = add1(a);
    let c = add1(b);
    return c + a;
}

fn cond_only(n: i64) -> i64 {
    let i = 0;
    let s = 0;
    while (i < n) {
        let t = s + 3;
        s = t + 1;
        i = i + 1;
    }
    return s;
}

fn go() -> i64 {
    let p: own *i64 = malloc(8);
    *p = 42;
    let n = *p;
    let q = add1(n);
    return q;
}

fn main() -> i32 {
    print_int(sum_loop(5));
    println("");
    print_int(scan(3, 8));
    println("");
    print_int(scan(10, 4));
    println("");
    print_int(nest(4));
    println("");
    print_int(pick(2, 5));
    println("");
    print_int(pick(5, 2));
    println("");
    print_int(across(10));
    println("");
    print_int(cond_only(4));
    println("");
    print_int(go());
    println("");
    return 0;
}
