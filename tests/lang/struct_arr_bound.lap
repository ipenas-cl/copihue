// The bound of a[i] on a local array of structs is its length (0.45.2). Before,
// it was the count of 8-byte slots: [P; 2] with a 16-byte P compared i with 4,
// so ps[2] and ps[3] read and wrote the 32 bytes past the array. Every form at
// the last valid index, the neighbour left intact, then ps[2].x traps.
struct P { x: i64, y: i64 }

fn sum(p: P) -> i64 { return p.x * 10 + p.y; }

fn main() -> i32 {
    let guard: i64 = 77;
    let ps: [P; 2];
    let q: P;
    q.x = 3;
    q.y = 4;
    let i: i64 = 1;
    ps[0].x = 1;
    ps[0].y = 2;
    ps[i] = q;
    ps[i].y = 5;
    let t: P = ps[i];
    print_int(ps[i].x);
    println("");
    print_int(sum(ps[i]));
    println("");
    print_int(t.y);
    println("");
    print_int(sum(ps[0]));
    println("");
    print_int(guard);
    println("");
    i = i + 1;
    print_int(ps[i].x);
    println("");
    print_int(99);
    println("");
    return 0;
}
