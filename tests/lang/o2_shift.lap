// Hosted -O2: insertion shift without the upper bounds check, and a
// bottom-tested dot product. -O0 prints the same lines. A loop that is not
// the proved shape keeps the old path and must still match.

fn pack(a0: i64, a1: i64, a2: i64, a3: i64) -> i64 {
    return ((a0 + 20) * 1000000) + ((a1 + 20) * 10000) + ((a2 + 20) * 100) + (a3 + 20);
}

fn sort_rev() -> i64 {
    let n = 4;
    let a: [i64; 4];
    let i = 0;
    let j = 0;
    let key = 0;
    while (i < n) {
        a[i] = n - i;
        i = i + 1;
    }
    i = 1;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return pack(a[0], a[1], a[2], a[3]);
}

fn sort_sorted() -> i64 {
    let n = 4;
    let a: [i64; 4];
    let i = 0;
    let j = 0;
    let key = 0;
    while (i < n) {
        a[i] = i + 1;
        i = i + 1;
    }
    i = 1;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return pack(a[0], a[1], a[2], a[3]);
}

fn sort_dups() -> i64 {
    let n = 4;
    let a: [i64; 4];
    let i = 0;
    let j = 0;
    let key = 0;
    a[0] = 3;
    a[1] = 1;
    a[2] = 3;
    a[3] = 1;
    i = 1;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return pack(a[0], a[1], a[2], a[3]);
}

fn sort_neg() -> i64 {
    let n = 4;
    let a: [i64; 4];
    let i = 0;
    let j = 0;
    let key = 0;
    a[0] = 0 - 2;
    a[1] = 5;
    a[2] = 0 - 8;
    a[3] = 0;
    i = 1;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return pack(a[0], a[1], a[2], a[3]);
}

fn sort_n1() -> i64 {
    let n = 1;
    let a: [i64; 4];
    let i = 0;
    let j = 0;
    let key = 0;
    a[0] = 7;
    a[1] = 9;
    a[2] = 9;
    a[3] = 9;
    i = 0;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return a[0];
}

fn sort_one() -> i64 {
    let n = 4;
    let a: [i64; 4];
    let i = 0;
    let j = 0;
    let key = 0;
    a[0] = 1;
    a[1] = 3;
    a[2] = 2;
    a[3] = 4;
    i = 1;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return pack(a[0], a[1], a[2], a[3]);
}

fn sort_from0() -> i64 {
    let n = 4;
    let a: [i64; 4];
    let i = 0;
    let j = 0;
    let key = 0;
    a[0] = 2;
    a[1] = 1;
    a[2] = 0;
    a[3] = 3;
    i = 0;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && key < a[j]) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return pack(a[0], a[1], a[2], a[3]);
}

fn sort_let() -> i64 {
    let n = 3;
    let a: [i64; 3];
    a[0] = 5;
    a[1] = 4;
    a[2] = 3;
    let i = 1;
    while (i < n) {
        let key = a[i];
        let j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return a[0] * 100 + a[1] * 10 + a[2];
}

fn shifts_ge() -> i64 {
    let n = 3;
    let a: [i64; 3];
    let i = 0;
    let j = 0;
    let key = 0;
    let z = 0;
    a[0] = 2;
    a[1] = 2;
    a[2] = 1;
    i = 1;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] >= key) {
            a[j + 1] = a[j];
            j = j - 1;
            z = z + 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return z * 1000 + a[0] * 100 + a[1] * 10 + a[2];
}

fn shifts_extra() -> i64 {
    let n = 3;
    let a: [i64; 3];
    let i = 0;
    let j = 0;
    let key = 0;
    let z = 0;
    a[0] = 4;
    a[1] = 1;
    a[2] = 3;
    i = 1;
    while (i < n) {
        key = a[i];
        j = i - 1;
        while (j >= 0 && a[j] > key) {
            a[j + 1] = a[j];
            j = j - 1;
            z = z + 1;
        }
        a[j + 1] = key;
        i = i + 1;
    }
    return z * 1000 + a[0] * 100 + a[1] * 10 + a[2];
}

fn dot1() -> i64 {
    let n = 1;
    let a: [i64; 1];
    let b: [i64; 1];
    let i = 0;
    let j = 0;
    let k = 0;
    let s = 0;
    a[0] = 6;
    b[0] = 7;
    k = 0;
    while (k < n) {
        s = s + a[i * n + k] * b[k * n + j];
        k = k + 1;
    }
    return s;
}

fn dot1neg() -> i64 {
    let n = 1;
    let a: [i64; 1];
    let b: [i64; 1];
    let i = 0;
    let j = 0;
    let k = 0;
    let s = 0;
    a[0] = 0 - 3;
    b[0] = 0 - 5;
    k = 0;
    while (k < n) {
        s = s + a[i * n + k] * b[k * n + j];
        k = k + 1;
    }
    return s;
}

fn dot_neg() -> i64 {
    let n = 2;
    let a: [i64; 4];
    let b: [i64; 4];
    let i = 0;
    let j = 0;
    let k = 0;
    let s = 0;
    let sum = 0;
    a[0] = 0 - 2;
    a[1] = 5;
    a[2] = 3;
    a[3] = 0 - 4;
    b[0] = 0 - 3;
    b[1] = 0 - 1;
    b[2] = 4;
    b[3] = 2;
    i = 0;
    while (i < n) {
        j = 0;
        while (j < n) {
            s = 0;
            k = 0;
            while (k < n) {
                s = s + a[i * n + k] * b[k * n + j];
                k = k + 1;
            }
            sum = sum + s;
            j = j + 1;
        }
        i = i + 1;
    }
    return sum;
}

fn main() -> i32 {
    print_int(sort_rev());
    println("");
    print_int(sort_sorted());
    println("");
    print_int(sort_dups());
    println("");
    print_int(sort_neg());
    println("");
    print_int(sort_n1());
    println("");
    print_int(sort_one());
    println("");
    print_int(sort_from0());
    println("");
    print_int(sort_let());
    println("");
    print_int(shifts_ge());
    println("");
    print_int(shifts_extra());
    println("");
    print_int(dot1());
    println("");
    print_int(dot1neg());
    println("");
    print_int(dot_neg());
    println("");
    return 0;
}
