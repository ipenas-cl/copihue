// Two hosted threads, each adding 1000000 with fetch_add. No libc.
let volatile counter: u64 = 0;
let volatile tid1: u32 = 0;
let volatile tid2: u32 = 0;
let stack1: [u8; 65536];
let stack2: [u8; 65536];

fn worker() -> i64 {
    let i = 0;
    sched_setaffinity(0);
    cpu_pause();
    while (i < 1000000) {
        fetch_add(&counter, 1);
        i = i + 1;
    }
    return 0;
}

fn main() -> i64 {
    let t1 = thread_spawn(&worker, stack1 + 65536, &tid1);
    let t2 = thread_spawn(&worker, stack2 + 65536, &tid2);
    print_int(t1 > 0);
    println("");
    print_int(t2 > 0);
    println("");
    print_int(thread_join(&tid1));
    println("");
    print_int(thread_join(&tid2));
    println("");
    print_int(atomic_load_acquire(&counter));
    println("");
    print_int(sched_setaffinity(0));
    println("");
    print_int(sched_setaffinity(1024));
    println("");
    print_int(cpu_pause());
    println("");
    return 0;
}
