// A 64-bit TSS is 104 bytes. Only a packed struct puts rsp0 at offset 4
// and IST1 at offset 36. set_rsp0 is the context-switch write: it changes
// rsp0 and leaves the IST slots alone.
packed struct Tss {
    reserved0: u32,
    rsp0: u64,
    rsp1: u64,
    rsp2: u64,
    reserved1: u64,
    ist1: u64,
    ist2: u64,
    ist3: u64,
    ist4: u64,
    ist5: u64,
    ist6: u64,
    ist7: u64,
    reserved2: u64,
    reserved3: u16,
    iomap: u16
}

fn set_rsp0(p: *Tss, sp: i64) -> i64 {
    p->rsp0 = sp;
    return p->rsp0;
}

fn main() -> i32 {
    let t: Tss;
    let b: *u8 = &t as *u8;
    t.reserved0 = 0x11;
    t.rsp0 = 0x22;
    t.ist1 = 0x33;
    t.iomap = 104;
    print_int(b[0]); println("");
    print_int(b[3]); println("");
    print_int(b[4]); println("");
    print_int(b[5]); println("");
    print_int(b[36]); println("");
    print_int(b[100]); println("");
    print_int(b[101]); println("");
    print_int(b[102]); println("");
    print_int(b[103]); println("");
    let got = set_rsp0(&t, 0x44);
    print_int(b[4]); println("");
    print_int(b[36]); println("");
    print_int(got); println("");
    return 0;
}
