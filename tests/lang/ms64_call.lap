// The Microsoft x64 convention (0.44.6), hosted. A call to an `ms64 fn`, or through a variable of
// type `ms64 fn`, passes arguments 1 to 4 in rcx, rdx, r8, r9, the rest at [rsp+32] on, with 32
// bytes of shadow space and rsp aligned to 16 at the call. The callees written in assembly
// (`naked ms64 fn`) check that rsp was 8 modulo 16 on entry, use the shadow space, read the stack
// arguments, and clobber every volatile register; each returns its arguments as decimal digits
// (argument n is digit n) or 0 when the entry alignment was wrong. The callees written in Copihue
// (`ms64 fn`) are called the same way, and `preserve` checks that they keep rdi, rsi, rbx, r13.
//
// The expected output (tests/expected/tests/lang/ms64_call.out) was written by hand and agrees with
// the same calls run under QEMU by tests/ms64/kernel.lap.

let gp8: ms64 fn = 0;


// 1 when rsp was 8 modulo 16 at the first instruction, 0 otherwise.
naked ms64 fn aligned() -> i64 {
    asm("mov rax, rsp");
    asm("and eax, 15");
    asm("cmp eax, 8");
    asm("sete al");
    asm("movzx eax, al");
}

// Returns its argument. The shadow space takes a store and gives it back.
naked ms64 fn f1(a: i64) -> i64 {
    asm("mov [rsp+8], rcx");
    asm("xor ecx, ecx");
    asm("mov rax, [rsp+8]");
    asm("xor edx, edx");
    asm("xor r8d, r8d");
    asm("xor r9d, r9d");
    asm("xor r10d, r10d");
    asm("xor r11d, r11d");
}

// d*1000 + c*100 + b*10 + a: digit n is argument n. rsp must be 8 modulo 16.
naked ms64 fn f4(a: i64, b: i64, c: i64, d: i64) -> i64 {
    asm("mov [rsp+8], rcx");
    asm("mov [rsp+16], rdx");
    asm("mov [rsp+24], r8");
    asm("mov [rsp+32], r9");
    asm("xor ecx, ecx");
    asm("xor edx, edx");
    asm("xor r8d, r8d");
    asm("xor r9d, r9d");
    asm("xor r10d, r10d");
    asm("xor r11d, r11d");
    asm("mov rax, [rsp+32]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+24]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+16]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+8]");
    asm("mov r10, rsp");
    asm("and r10d, 15");
    asm("cmp r10d, 8");
    asm("je .ok4");
    asm("xor eax, eax");
    asm(".ok4:");
}

// The fifth argument is at [rsp+40] after the call, above the shadow space.
naked ms64 fn f5(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    asm("mov [rsp+8], rcx");
    asm("mov [rsp+16], rdx");
    asm("mov [rsp+24], r8");
    asm("mov [rsp+32], r9");
    asm("mov rax, [rsp+40]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+32]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+24]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+16]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+8]");
    asm("xor ecx, ecx");
    asm("xor edx, edx");
    asm("xor r8d, r8d");
    asm("xor r9d, r9d");
    asm("xor r10d, r10d");
    asm("xor r11d, r11d");
    asm("mov r10, rsp");
    asm("and r10d, 15");
    asm("cmp r10d, 8");
    asm("je .ok5");
    asm("xor eax, eax");
    asm(".ok5:");
}

naked ms64 fn f6(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    asm("mov rax, [rsp+48]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+40]");
    asm("imul rax, rax, 10");
    asm("add rax, r9");
    asm("imul rax, rax, 10");
    asm("add rax, r8");
    asm("imul rax, rax, 10");
    asm("add rax, rdx");
    asm("imul rax, rax, 10");
    asm("add rax, rcx");
    asm("mov r10, rsp");
    asm("and r10d, 15");
    asm("cmp r10d, 8");
    asm("je .ok6");
    asm("xor eax, eax");
    asm(".ok6:");
}

naked ms64 fn f8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    asm("mov rax, [rsp+64]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+56]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+48]");
    asm("imul rax, rax, 10");
    asm("add rax, [rsp+40]");
    asm("imul rax, rax, 10");
    asm("add rax, r9");
    asm("imul rax, rax, 10");
    asm("add rax, r8");
    asm("imul rax, rax, 10");
    asm("add rax, rdx");
    asm("imul rax, rax, 10");
    asm("add rax, rcx");
    asm("mov r10, rsp");
    asm("and r10d, 15");
    asm("cmp r10d, 8");
    asm("je .ok8");
    asm("xor eax, eax");
    asm(".ok8:");
}

// The same digits, written in Copihue.
ms64 fn c0() -> i64 { return 42; }
ms64 fn c1(a: i64) -> i64 { return a + 100; }
ms64 fn c4(a: i64, b: i64, c: i64, d: i64) -> i64 {
    return d * 1000 + c * 100 + b * 10 + a;
}
ms64 fn c5(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    return e * 10000 + d * 1000 + c * 100 + b * 10 + a;
}
ms64 fn c6(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    return f * 100000 + e * 10000 + d * 1000 + c * 100 + b * 10 + a;
}
ms64 fn c8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return h * 10000000 + g * 1000000 + f * 100000 + e * 10000 + d * 1000 + c * 100 + b * 10 + a;
}
// Calls itself through the thunk; the product is 10!.
ms64 fn fact(n: i64) -> i64 {
    if (n < 2) { return 1; }
    return n * fact(n - 1);
}
// Takes a function pointer and calls it, a Copihue ms64 fn through an ms64 fn parameter.
ms64 fn apply4(f: ms64 fn, a: i64, b: i64, c: i64, d: i64) -> i64 {
    return f(a, b, c, d);
}

fn plain(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64 {
    return a + b + c + d + e + f + g;
}
// An ms64 function that uses a System V one with seven arguments, to cross the two.
ms64 fn mixed(a: i64, b: i64) -> i64 {
    return plain(a, b, 1, 1, 1, 1, 1);
}

// Calls fp with the Microsoft convention after filling rdi, rsi, rbx, and r13 with markers, and
// returns a bit for each one that came back unchanged: 15 when the callee preserved all four.
naked fn preserve(fp: i64) -> i64 {
    asm("push rbx");
    asm("push r12");
    asm("push r13");
    asm("mov r12, rdi");
    asm("mov rdi, 0x1111");
    asm("mov rsi, 0x2222");
    asm("mov rbx, 0x3333");
    asm("mov r13, 0x4444");
    asm("sub rsp, 32");
    asm("mov ecx, 1");
    asm("mov edx, 2");
    asm("mov r8d, 3");
    asm("mov r9d, 4");
    asm("call r12");
    asm("add rsp, 32");
    asm("xor eax, eax");
    asm("cmp rdi, 0x1111");
    asm("sete al");
    asm("xor ecx, ecx");
    asm("cmp rsi, 0x2222");
    asm("sete cl");
    asm("shl ecx, 1");
    asm("or eax, ecx");
    asm("xor ecx, ecx");
    asm("cmp rbx, 0x3333");
    asm("sete cl");
    asm("shl ecx, 2");
    asm("or eax, ecx");
    asm("xor ecx, ecx");
    asm("cmp r13, 0x4444");
    asm("sete cl");
    asm("shl ecx, 3");
    asm("or eax, ecx");
    asm("pop r13");
    asm("pop r12");
    asm("pop rbx");
}


fn show(v: i64) -> i64 {
    print_int(v);
    println("");
    return 0;
}

fn main() -> i64 {
    let keep: i64 = 99;
    let p4: ms64 fn = &f4;
    let q5: ms64 fn = &c5;
    gp8 = &f8;
    show(aligned());
    show(5 + aligned());
    show(f1(7));
    show(f4(1, 2, 3, 4));
    show(f5(1, 2, 3, 4, 5));
    show(f6(1, 2, 3, 4, 5, 6));
    show(f8(1, 2, 3, 4, 5, 6, 7, 8));
    show(f4(f1(1), f1(2), f1(3), f1(4)));
    show(f4(1, 2, 3, aligned() + 3));
    show(p4(4, 3, 2, 1));
    show(q5(1, 2, 3, 4, 5));
    show(gp8(8, 7, 6, 5, 4, 3, 2, 1));
    show(c0());
    show(c1(5));
    show(c4(1, 2, 3, 4));
    show(c5(1, 2, 3, 4, 5));
    show(c6(1, 2, 3, 4, 5, 6));
    show(c8(1, 2, 3, 4, 5, 6, 7, 8));
    show(fact(10));
    show(apply4(&f4, 1, 2, 3, 4));
    show(apply4(&c4, 4, 3, 2, 1));
    show(mixed(2, 3));
    show(preserve(&c0));
    show(preserve(&c8));
    show(preserve(&fact));
    show(keep);
    show(c4(1, 2, 3, 4) + f5(1, 2, 3, 4, 5) + c1(f1(1)));
    return 0;
}
