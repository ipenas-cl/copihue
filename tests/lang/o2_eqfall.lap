// Hosted -O2 lays out `if (x == k)` inside a while so the not-equal arm
// falls through and the equal arm is the branch. -O0 prints the same lines.
// The tail after the if runs once. A nested if stays on the ordinary layout.
// An owning local in the body is freed on both arms.

fn go() -> i64 {
    let buf: [i64; 8];
    let i = 0;
    let v = 0;
    let sum = 0;
    let n = 0;
    buf[0] = 49;
    buf[1] = 50;
    buf[2] = 44;
    buf[3] = 51;
    buf[4] = 44;
    i = 0;
    while (i < 5) {
        let c = buf[i];
        if (c == 44) {
            sum = sum + v;
            v = 0;
        } else {
            v = v * 10 + (c - 48);
        }
        i = i + 1;
        n = n + 1;
    }
    sum = sum + v;
    print_int(sum);
    print(" ");
    print_int(n);
    println("");

    // The equal arm is the common one. Still one visit to the tail.
    i = 0;
    sum = 0;
    n = 0;
    while (i < 4) {
        if (i == 0) {
            sum = sum + 1;
        } else {
            sum = sum + 10;
        }
        i = i + 1;
        n = n + 1;
    }
    print_int(sum);
    print(" ");
    print_int(n);
    println("");

    // Nested if: not this layout. Both sides still run.
    i = 0;
    sum = 0;
    while (i < 4) {
        if (i == 2) {
            if (i > 0) { sum = sum + 5; }
        } else {
            sum = sum + i;
        }
        i = i + 1;
    }
    print_int(sum);
    println("");

    // break keeps the ordinary loop.
    i = 0;
    sum = 0;
    while (i < 9) {
        if (i == 3) {
            break;
        } else {
            sum = sum + i;
        }
        i = i + 1;
    }
    print_int(sum);
    print(" ");
    print_int(i);
    println("");

    // Owning local, freed on the equal arm and on the other arm.
    i = 0;
    sum = 0;
    while (i < 3) {
        let p: own *i64 = malloc(8);
        *p = i + 1;
        if (i == 1) {
            sum = sum + *p;
        } else {
            sum = sum + *p * 10;
        }
        i = i + 1;
    }
    print_int(sum);
    println("");
    return 0;
}

fn main() -> i32 {
    go();
    return 0;
}
