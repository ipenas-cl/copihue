// The bound does not fit the local array, so -O2 must not drop the trap.
struct Cell { n: i64, tag: u8, pad: i64 }

fn main() -> i32 {
    let a: [Cell; 4];
    let i = 0;
    let n = 13;
    let s = 0;
    while (i < n) {
        s = s + a[i].n;
        i = i + 1;
    }
    print_int(s);
    println("");
    return 0;
}
