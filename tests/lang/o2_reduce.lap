// Hosted -O2: immediate array stores, a byte fill, an inverted while, and a
// linear sum that is deleted only when every partial fits in i64. -O0 prints
// the same lines. A sum that can wrap stays a loop.

fn tick(x: i64) -> i64 {
    return x + 1;
}

fn fold_small() -> i64 {
    let n = 10;
    let s = 0;
    let i = 0;
    while (i < n) {
        s = s + i * 3 + 1;
        i = i + 1;
    }
    return s * 100 + i;
}

fn fold_none() -> i64 {
    let n = 0 - 4;
    let s = 7;
    let i = 0;
    while (i < n) {
        s = s + i * 3 + 1;
        i = i + 1;
    }
    return s * 10 + i;
}

fn fold_mid() -> i64 {
    let s = 10;
    let i = 2;
    while (i < 5) {
        s = s + i;
        i = i + 1;
    }
    return s * 10 + i;
}

fn fold_down() -> i64 {
    let s = 0;
    let i = 0;
    while (i < 4) {
        s = s + i * (0 - 1);
        i = i + 1;
    }
    return s;
}

fn fold_mix() -> i64 {
    let s = 0;
    let i = 0;
    while (i < 4) {
        s = s + i + (0 - 1);
        i = i + 1;
    }
    return s;
}

fn fold_quad() -> i64 {
    let s = 0;
    let i = 0;
    while (i < 5) {
        s = s + i * i;
        i = i + 1;
    }
    return s;
}

fn fold_ovf() -> i64 {
    let n = 5;
    let s = 0;
    let i = 0;
    while (i < n) {
        s = s + i * 3000000000000000000;
        i = i + 1;
    }
    return s;
}

fn fold_wrap() -> i64 {
    let n = 2;
    let s = 9223372036854775807;
    let i = 0;
    while (i < n) {
        s = s + 1;
        i = i + 1;
    }
    return s;
}

fn filled() -> i64 {
    let a: [u8; 8];
    let i = 0;
    while (i < 5) {
        a[i] = 7;
        i = i + 1;
    }
    let s = 0;
    i = 0;
    while (i < 5) {
        s = s + a[i];
        i = i + 1;
    }
    return s * 100 + i;
}

fn fill_i() -> i64 {
    let a: [u8; 4];
    let i = 0;
    while (i < 4) {
        a[i] = 1;
        i = i + 1;
    }
    return i;
}

fn fill_zero() -> i64 {
    let a: [u8; 4];
    let i = 0;
    while (i < 0) {
        a[i] = 1;
        i = i + 1;
    }
    return i;
}

fn fill_neg() -> i64 {
    let a: [u8; 4];
    let n = 0 - 3;
    let i = 0;
    while (i < n) {
        a[i] = 1;
        i = i + 1;
    }
    return i + 1;
}

fn fill_rt() -> i64 {
    let a: [u8; 8];
    let n = 3;
    n = 2 + 1;
    let i = 0;
    while (i < n) {
        a[i] = 4;
        i = i + 1;
    }
    let s = 0;
    let j = 0;
    while (j < 3) {
        s = s + a[j];
        j = j + 1;
    }
    return s * 10 + i;
}

fn holes() -> i64 {
    let a: [u8; 4];
    a[0] = 0;
    a[1] = 2;
    a[2] = 255;
    a[3] = 1;
    let s = 0;
    let i = 0;
    while (i < 4) {
        s = s + a[i];
        i = i + 1;
    }
    return s;
}

fn holes_neg() -> i64 {
    let a: [i8; 2];
    a[0] = (0 - 1) as i8;
    a[1] = 3;
    return a[0] + a[1];
}

fn early() -> i64 {
    let s = 0;
    let i = 0;
    while (i < 10) {
        if (i == 4) {
            break;
        }
        s = s + i;
        i = i + 1;
    }
    return s * 10 + i;
}

fn called() -> i64 {
    let s = 0;
    let i = 0;
    while (i < 4) {
        s = s + tick(i);
        i = i + 1;
    }
    return s;
}

fn piece(v: i64, k: i64) -> i64 {
    let x = v;
    let neg = 0;
    if (x < 0) {
        neg = 1;
        x = 0 - x;
    }
    let a = x % 1000000;
    let y = x / 1000000;
    let b = y % 1000000;
    let c = y / 1000000;
    if (k == 0) {
        return neg;
    }
    if (k == 1) {
        return c;
    }
    if (k == 2) {
        return b;
    }
    return a;
}

fn fill_too_long() -> i64 {
    let a: [u8; 2];
    let i = 0;
    while (i < 5) {
        a[i] = 1;
        i = i + 1;
    }
    return i;
}

fn main() -> i32 {
    print_int(fold_small());
    println("");
    print_int(fold_none());
    println("");
    print_int(fold_mid());
    println("");
    print_int(fold_down());
    println("");
    print_int(fold_mix());
    println("");
    print_int(fold_quad());
    println("");
    print_int(piece(fold_ovf(), 0));
    println("");
    print_int(piece(fold_ovf(), 1));
    println("");
    print_int(piece(fold_ovf(), 2));
    println("");
    print_int(piece(fold_ovf(), 3));
    println("");
    print_int(piece(fold_wrap(), 0));
    println("");
    print_int(piece(fold_wrap(), 1));
    println("");
    print_int(piece(fold_wrap(), 2));
    println("");
    print_int(piece(fold_wrap(), 3));
    println("");
    print_int(filled());
    println("");
    print_int(fill_i());
    println("");
    print_int(fill_zero());
    println("");
    print_int(fill_neg());
    println("");
    print_int(fill_rt());
    println("");
    print_int(holes());
    println("");
    print_int(holes_neg());
    println("");
    print_int(early());
    println("");
    print_int(called());
    println("");

    let a = 0 - 7;
    print_int(a / 3);
    println("");
    print_int(a % 3);
    println("");
    print_int(7 / (0 - 3));
    println("");
    print_int(7 % (0 - 3));
    println("");
    print_int((0 - 8) / 2);
    println("");
    print_int((0 - 8) % 2);
    println("");
    print_int((0 - 7) / 2);
    println("");
    print_int((0 - 7) % 2);
    println("");
    print_int(1 / 0);
    println("");
    print_int(1 % 0);
    println("");
    print_int(100 % 7);
    println("");
    print_int((0 - 100) % 7);
    println("");
    print_int(20 / 4);
    println("");
    print_int(20 % 4);
    println("");
    return 0;
}
