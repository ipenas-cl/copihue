// Flat kernel at 0x8000 for QEMU, loaded by tests/usermode/boot.lap, like tests/memfix/kernel.lap.
// A local array of structs, [P; 2] with a 16-byte P (0.45.2). tests/memfix/run.sh builds it with
// --checked, so a[i] is checked against the length, 2, and not against the 4 slots of the array.
// Every form at the last valid index must hold, and a field a struct literal does not name must be
// 0 over a dirty stack; then COM1 says MEMOK (FAIL06 or FAIL07 before 0.45.2: the literal kept the
// 0xFF bytes). ps[2].x comes next: the check ends in `syscall`, which faults here, so LEAK must
// never follow. Before 0.45.2 the read went through and COM1 said MEMOKLEAK.

struct P { x: i64, y: i64 }

let bad: i64 = 0;

data gdt {
    dq 0;
    dw 0;
    dw 0;
    db 0;
    db 0x9A;
    db 0x20;
    db 0;
    dw 0xFFFF;
    dw 0;
    db 0;
    db 0x92;
    db 0xCF;
    db 0;
}

data gdtr {
    dw 23;
    dd gdt;
}

fn serial_putc(c: i64) -> i64 {
    let tries = 0;
    while ((inb(0x3FD) & 0x20) == 0 && tries < 1000) { tries = tries + 1; }
    outb(0x3F8, c);
    return 0;
}

fn check(n: i64, ok: i64) -> i64 {
    if (ok == 0 && bad == 0) { bad = n; }
    return 0;
}

fn sum(p: P) -> i64 { return p.x * 10 + p.y; }

// Every byte of these stack slots to 0xFF, for the literals that come next.
fn dirty() -> i64 {
    let junk: [i64; 16];
    let i: i64 = 0;
    while (i < 16) {
        junk[i] = -1;
        i = i + 1;
    }
    return junk[15];
}

// A field a literal does not name is 0 (0.45.2): x here, and the first element's x.
fn let_unnamed() -> i64 {
    let p: P = P { y: 9 };
    return p.x;
}

fn elem_unnamed() -> i64 {
    let ps: [P; 2] = [P { y: 2 }, P { x: 3 }];
    return ps[0].x + ps[1].y;
}

fn kmain() -> i64 {
    let guard: i64 = 77;
    let ps: [P; 2];
    let q: P;
    q.x = 3;
    q.y = 4;
    let i: i64 = 1;
    ps[0].x = 1;
    ps[0].y = 2;
    ps[i] = q;
    check(1, ps[1].x == 3 && ps[1].y == 4);
    ps[i].y = 5;
    check(2, ps[i].y == 5 && ps[0].y == 2);
    let t: P = ps[i];
    check(3, t.x == 3 && t.y == 5);
    check(4, sum(ps[i]) == 35 && sum(ps[0]) == 12);
    check(5, guard == 77);
    dirty();
    check(6, let_unnamed() == 0);
    dirty();
    check(7, elem_unnamed() == 0);

    if (bad == 0) {
        serial_putc(77);
        serial_putc(69);
        serial_putc(77);
        serial_putc(79);
        serial_putc(75);
    } else {
        serial_putc(70);
        serial_putc(65);
        serial_putc(73);
        serial_putc(76);
        serial_putc(48 + bad / 10);
        serial_putc(48 + bad % 10);
    }
    i = i + 1;
    check(8, ps[i].x == 0);
    serial_putc(76);
    serial_putc(69);
    serial_putc(65);
    serial_putc(75);
    while (1) { hlt(); }
    return 0;
}

bits 32 naked fn _start() {
    cli();
    asm("lgdt [gdtr]");
    asm("mov ax, 0x10");
    asm("mov ds, ax");
    asm("mov es, ax");
    asm("mov ss, ax");
    asm("mov esp, 0x6000");
    asm("cld");
    asm("xor eax, eax");
    asm("mov edi, 0x1000");
    asm("mov ecx, 3072");
    asm("rep stosd");
    asm("mov dword [0x1000], 0x2007");
    asm("mov dword [0x2000], 0x3007");
    asm("mov dword [0x3000], 0x87");
    asm("mov eax, cr4");
    asm("or eax, 0x20");
    asm("mov cr4, eax");
    asm("mov eax, 0x1000");
    asm("mov cr3, eax");
    asm("mov ecx, 0xC0000080");
    asm("rdmsr");
    asm("or eax, 0x100");
    asm("wrmsr");
    asm("mov eax, cr0");
    asm("or eax, 0x80000000");
    asm("mov cr0, eax");
    asm("jmp 0x08:kmain");
}
